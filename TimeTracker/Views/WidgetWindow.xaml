<Window x:Class="TimeTracker.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TimeTracker.Converters"
        Title="TimeTracker" Height="Auto" Width="310"
        Icon="pack://application:,,,/Resources/app_icon.png"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="False" ResizeMode="NoResize" ShowInTaskbar="True"
        SizeToContent="Height">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RecalculateTimerCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToColorConverter x:Key="BoolToColor"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource BgMid}"
            BorderBrush="#22FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header / drag handle -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{StaticResource BgDark}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/app_icon.png" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="TimeTracker" Foreground="{StaticResource Accent}"
                                   FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Background="Transparent"
                            Foreground="{StaticResource TextSecondary}" BorderThickness="0"
                            FontSize="12" Padding="4,2" Cursor="Hand"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Countdown -->
            <Border Grid.Row="1" Padding="16,14,16,10">
                <StackPanel>
                    <TextBlock Text="{Binding TimerLabelText}" Style="{StaticResource Label}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CountdownText}"
                               FontFamily="Segoe UI" FontSize="38" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{Binding IsUrgent, Converter={StaticResource BoolToColor}}"/>

                    <!-- Urgent pulse -->
                    <TextBlock Text="⚡ È ora di registrare!" Foreground="{StaticResource Urgent}"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"
                               Visibility="{Binding IsUrgent, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Today summary -->
            <Border Grid.Row="2" Margin="10,0,10,8" Padding="12,10"
                    Background="{StaticResource BgDark}" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding TodaySummary}" Foreground="{StaticResource TextSecondary}"
                               FontFamily="Segoe UI" FontSize="11" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding ProjectTotals}" Margin="0,6,0,0"
                                  Visibility="{Binding ProjectTotals.Count, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="{StaticResource Accent}" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="10,0,10,14" >
                <Button Content="✍ Ho fatto qualcosa" Style="{StaticResource AccentButton}"
                        Command="{Binding TriggerNowCommand}" Margin="0,0,6,0"/>
                <Button Content="📋" Style="{StaticResource GhostButton}" Padding="10,8"
                        Command="{Binding OpenLogCommand}" ToolTip="Log attività"/>
                <Button Content="⚙" Style="{StaticResource GhostButton}" Padding="10,8"
                        Command="{Binding OpenSettingsCommand}" Margin="4,0,0,0" ToolTip="Impostazioni"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
