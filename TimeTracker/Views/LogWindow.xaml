<Window x:Class="TimeTracker.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TimeTracker.Converters"
        xmlns:vm="clr-namespace:TimeTracker.ViewModels"
        xmlns:models="clr-namespace:TimeTracker.Models"
        Title="Log Attività" Height="620" Width="780"
        Icon="pack://application:,,,/Resources/app_icon.png"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource BgMid}"
            BorderBrush="#22FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{StaticResource BgDark}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/app_icon.png" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="Log Attività" Foreground="{StaticResource Accent}"
                                   FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Background="Transparent"
                            Foreground="{StaticResource TextSecondary}" BorderThickness="0"
                            FontSize="12" Padding="6,2" Cursor="Hand"
                            Command="{Binding CloseCommand}"/>
                </Grid>
            </Border>

            <!-- Date picker + toggle -->
            <Border Grid.Row="1" Padding="16,12,16,8" Background="{StaticResource BgDark}"
                    BorderBrush="#11FFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Data:" Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                    Background="White" Foreground="Black"
                                    FontFamily="Segoe UI" FontSize="13" Width="140"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Vista raggruppata" Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox IsChecked="{Binding ShowGrouped}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Activity list -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="10,8">
                <StackPanel>
                    <!-- Grouped view -->
                    <ItemsControl ItemsSource="{Binding GroupedActivities}"
                                  Visibility="{Binding ShowGrouped, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GroupedActivity}">
                                <Border Margin="0,0,0,6" Padding="14,10" CornerRadius="8"
                                        Background="{StaticResource BgDark}"
                                        BorderBrush="#11FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{StaticResource BgCard}" CornerRadius="4"
                                                        Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Project}" Foreground="{StaticResource Accent}"
                                                               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="#1F293D" CornerRadius="4"
                                                        Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding LocationDisplay}" Foreground="{StaticResource TextSecondary}"
                                                               FontFamily="Segoe UI" FontSize="11"/>
                                                </Border>
                                                <TextBlock Text="(raggruppate)" Foreground="{StaticResource TextSecondary}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           Visibility="{Binding IsGrouped, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextPrimary}"
                                                       FontFamily="Segoe UI" FontSize="13" Margin="0,4,0,0"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Entries.Count, StringFormat='{}{0} sessioni'}"
                                                       Foreground="{StaticResource TextSecondary}" FontSize="11"
                                                       Visibility="{Binding IsGrouped, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding DurationDisplay}"
                                                   Foreground="{StaticResource Success}" FontFamily="Segoe UI"
                                                   FontSize="15" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="12,0"/>

                                        <Button Grid.Column="2" Content="Separa" Style="{StaticResource GhostButton}"
                                                Padding="8,4" FontSize="11"
                                                Command="{Binding DataContext.SplitGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsGrouped, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Detailed view -->
                    <ItemsControl ItemsSource="{Binding Entries}"
                                  Visibility="{Binding ShowGrouped, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ActivityEntry}">
                                <Border Margin="0,0,0,6" Padding="14,10" CornerRadius="8"
                                        Background="{StaticResource BgDark}"
                                        BorderBrush="#11FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{StaticResource BgCard}" CornerRadius="4"
                                                        Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Project}" Foreground="{StaticResource Accent}"
                                                               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="#1F293D" CornerRadius="4"
                                                        Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding LocationDisplay}" Foreground="{StaticResource TextSecondary}"
                                                               FontFamily="Segoe UI" FontSize="11"/>
                                                </Border>
                                                <TextBlock Text="{Binding StartTime, StringFormat='{}{0:HH:mm} - '}"
                                                           Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding EndTime, StringFormat='{}{0:HH:mm}'}"
                                                           Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextPrimary}"
                                                       FontFamily="Segoe UI" FontSize="13" Margin="0,4,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Duration, StringFormat='{}{0:h\\h\\ mm\\m\\i\\n}'}"
                                                   Foreground="{StaticResource Success}" FontFamily="Segoe UI"
                                                   FontSize="15" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="12,0"/>

                                        <Button Grid.Column="2" Content="🗑" Style="{StaticResource DangerButton}"
                                                Padding="8,4" FontSize="11"
                                                Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Status bar -->
            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource Accent}" FontFamily="Segoe UI" FontSize="12"
                       Margin="16,4" Visibility="{Binding StatusMessage.Length, Converter={StaticResource BoolToVis}}"/>

            <!-- Actions -->
            <Border Grid.Row="4" Padding="16,10" Background="{StaticResource BgDark}"
                    CornerRadius="0,0,12,12" BorderBrush="#11FFFFFF" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🤖 AI Text" Style="{StaticResource AccentButton}"
                            Command="{Binding ExportAiTextCommand}" Margin="0,0,8,0"
                            ToolTip="Genera frasi in formato naturale per AI e copia negli appunti"/>
                    <Button Content="📄 CSV" Style="{StaticResource GhostButton}"
                            Command="{Binding ExportCsvCommand}" Margin="0,0,8,0"/>
                    <Button Content="📊 Excel" Style="{StaticResource GhostButton}"
                            Command="{Binding ExportExcelCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
