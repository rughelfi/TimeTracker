<Window x:Class="TimeTracker.Views.QuickEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TimeTracker.Converters"
        xmlns:models="clr-namespace:TimeTracker.Models"
        Title="Cosa hai fatto?" Height="Auto" Width="480"
        Icon="pack://application:,,,/Resources/app_icon.png"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" SizeToContent="Height"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource BgMid}"
            BorderBrush="{StaticResource Accent}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="24,20,24,24">

            <!-- Title -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Image Source="pack://application:,,,/Resources/app_icon.png" Width="22" Height="22" Margin="0,0,8,0"/>
                <TextBlock Text="Cosa hai fatto?" FontFamily="Segoe UI" FontSize="18"
                           FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            </StackPanel>
            <TextBlock Text="{Binding DurationDisplay, StringFormat='Durata sessione: {0}'}"
                       Style="{StaticResource Label}" Margin="0,0,0,14"/>

            <!-- Grouped Activities Section -->
            <TextBlock Text="ATTIVITÀ RECENTI (CLICCA PER AGGIUNGERE TEMPO)" Style="{StaticResource Label}"
                       Visibility="{Binding HasGroupedActivities, Converter={StaticResource BoolToVis}}"/>

            <Border Visibility="{Binding HasGroupedActivities, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource BgDark}" CornerRadius="8" Padding="6" Margin="0,0,0,16"
                    BorderBrush="#22FFFFFF" BorderThickness="1">
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding GroupedActivities}"
                             SelectedItem="{Binding SelectedGroupedActivity, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" CornerRadius="6"
                                                    Background="{StaticResource BgCard}"
                                                    BorderBrush="#22FFFFFF" BorderThickness="1"
                                                    Padding="10,8" Margin="0,0,0,4" Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1A3460"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#2A4470"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GroupedActivity}">
                                <Grid>
                                    <Grid.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.AddTimeToGroupedActivityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Grid.InputBindings>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource BgDark}" CornerRadius="4"
                                                    Padding="5,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Project}" Foreground="{StaticResource Accent}"
                                                           FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#1F293D" CornerRadius="4"
                                                    Padding="5,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding LocationDisplay}" Foreground="{StaticResource TextSecondary}"
                                                           FontFamily="Segoe UI" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding TodayDurationDisplay}" Foreground="{StaticResource Success}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextPrimary}"
                                                   FontFamily="Segoe UI" FontSize="12" Margin="0,3,0,0"
                                                   TextWrapping="Wrap" MaxHeight="36"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="+ Tempo" Style="{StaticResource AccentButton}"
                                            Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                            Command="{Binding DataContext.AddTimeToGroupedActivityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Aggiungi il tempo della sessione a questa attività e salva subito"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>

            <!-- Description -->
            <TextBlock Text="DESCRIZIONE ATTIVITÀ" Style="{StaticResource Label}"/>
            <Grid Margin="0,0,0,14">
                <TextBox x:Name="DescriptionBox" Style="{StaticResource DarkTextBox}"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="False" MaxLength="200"
                         Foreground="{StaticResource TextPrimary}"
                         KeyDown="DescriptionBox_KeyDown">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SaveCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Popup x:Name="SuggestionsPopup"
                       IsOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=DescriptionBox}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Slide">
                    <Border Background="{StaticResource BgDark}"
                            BorderBrush="{StaticResource Accent}" BorderThickness="1"
                            CornerRadius="8" Width="{Binding ElementName=DescriptionBox, Path=ActualWidth}"
                            Margin="0,4,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="Black"/>
                        </Border.Effect>
                        <ListBox x:Name="SuggestionsList"
                                 ItemsSource="{Binding FilteredSuggestions}"
                                 SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 MaxHeight="180" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" CornerRadius="4" Background="Transparent" Padding="10,7" Margin="2,1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1A3460"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#2A4470"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ActivitySuggestion}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Description}"
                                                   Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                        <Border Grid.Column="1" Visibility="{Binding Project.Length, Converter={StaticResource BoolToVis}}"
                                                Background="{StaticResource BgCard}" CornerRadius="4" Padding="5,1" Margin="8,0,6,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Project}" Foreground="{StaticResource Accent}"
                                                       FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{Binding Source}"
                                                   Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI"
                                                   FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>

            <!-- Project -->
            <TextBlock Text="PROGETTO" Style="{StaticResource Label}"/>
            <ComboBox Style="{StaticResource DarkComboBox}"
                      Background="White" Foreground="Black"
                      ItemsSource="{Binding Projects}"
                      SelectedItem="{Binding SelectedProject}"
                      Margin="0,0,0,14"/>

            <!-- Remote CheckBox -->
            <CheckBox Content="Lavoro da remoto"
                      IsChecked="{Binding IsRemote}"
                      Foreground="{StaticResource TextPrimary}"
                      FontFamily="Segoe UI"
                      FontSize="13"
                      Margin="0,0,0,20"
                      VerticalContentAlignment="Center"/>

            <!-- Actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="✓ Salva" Style="{StaticResource AccentButton}"
                        Command="{Binding SaveCommand}" FontSize="14" Padding="0,10"/>
                <Button Grid.Column="2" Content="Salta" Style="{StaticResource GhostButton}"
                        Command="{Binding CancelCommand}"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
